{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run frontend:build:vercel",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
