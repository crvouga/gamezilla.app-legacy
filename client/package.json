{
  "name": "client",
  "version": "1.0.0",
  "description": "client",
  "scripts": {
    "dev": "npm run build:css && concurrently \"npm run watch:app\" \"npm run watch:elm-ts-interop\"",
    "preview": "rm -rf dist && npm run build && sirv dist --single index.html",
    "build": "npm run build:css && npm run build:app",
    "build:app": "npx parcel build src/index.html --public-url ./",
    "build:css": "npx tailwindcss -i src/css/index.css -o tailwind-stuff/index.css",
    "watch:app": "rm -rf dist && npx parcel serve src/index.html",
    "watch:ts": "npx tsc --watch",
    "watch:elm-review": "npx elm-review --watch",
    "watch:elm-ts-interop": "npx elm-ts-interop --output elm-ts-interop-stuff/index.d.ts --watch",
    "init-elm-ts-interop": "npx elm-ts-interop init && cd src && mv *.elm elm"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@parcel/transformer-elm": "^2.0.1",
    "@types/tailwindcss": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^5.7.0",
    "@typescript-eslint/parser": "^5.7.0",
    "concurrently": "^6.5.1",
    "elm": "^0.19.1-3",
    "elm-review": "^2.6.1",
    "elm-ts-interop": "0.0.8",
    "eslint": "^7.7.0",
    "eslint-config-standard": "^14.1.1",
    "parcel": "^2.0.1",
    "sirv-cli": "^2.0.1",
    "tailwindcss": "^3.0.5",
    "typescript": "^4.5.4"
  }
}
