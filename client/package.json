{
  "name": "client",
  "version": "1.0.0",
  "description": "client",
  "scripts": {
    "dev": "concurrently \"npm run app:watch\" \"npm run elm-ts-interop:watch\"",
    "ts:watch": "npx tsc --watch",
    "elm:watch": "npx elm-review --watch",
    "app:watch": "rm -rf dist && npx parcel src/main.html",
    "app:build": " npx parcel build src/main.html --public-url ./",
    "css:watch": "SAFELISTING=true npx tailwindcss -i src/css/main.css -o src/css/build.css --watch",
    "css:build": "npx tailwindcss -i src/css/main.css -o src/css/build.css",
    "build": "npm run css:build && npm run app:build",
    "elm-ts-interop:watch": "npx elm-ts-interop --output src/typescript/elm-ts-interop.d.ts --watch",
    "elm-ts-interop:init": "npx elm-ts-interop init && cd src && mv *.elm elm"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@parcel/transformer-elm": "^2.0.1",
    "@types/tailwindcss": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^5.7.0",
    "@typescript-eslint/parser": "^5.7.0",
    "concurrently": "^6.5.1",
    "elm": "^0.19.1-3",
    "elm-review": "^2.6.1",
    "elm-ts-interop": "0.0.8",
    "eslint": "^7.7.0",
    "eslint-config-standard": "^14.1.1",
    "parcel": "^2.0.1",
    "tailwindcss": "^3.0.5",
    "typescript": "^4.5.4"
  }
}
