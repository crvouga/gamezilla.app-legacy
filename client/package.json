{
  "name": "client",
  "version": "1.0.0",
  "description": "a quick starter for simple elm project with parcel, tailwindcss and parcel",
  "scripts": {
    "dev": "concurrently \"npm run css:watch\" \"npm run app:watch\" \"npm run elm:watch\"",
    "elm:watch": "npx elm-review --watch",
    "app:watch": "rm -rf dist && npx parcel src/index.html",
    "app:build": " npx parcel build src/index.html --public-url ./",
    "css:watch": "SAFELISTING=true npx tailwindcss -i src/css/style.css -o src/css/build.css --watch",
    "css:build": "npx tailwindcss -i src/css/style.css -o src/css/build.css",
    "build": "npm run css:build && npm run app:build"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@parcel/transformer-elm": "^2.0.1",
    "@typescript-eslint/eslint-plugin": "^5.7.0",
    "@typescript-eslint/parser": "^5.7.0",
    "concurrently": "^6.5.1",
    "elm": "^0.19.1-3",
    "elm-review": "^2.6.1",
    "eslint": "^7.7.0",
    "eslint-config-standard": "^14.1.1",
    "parcel": "^2.0.1",
    "tailwindcss": "^3.0.5"
  }
}
