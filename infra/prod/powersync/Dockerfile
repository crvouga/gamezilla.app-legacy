FROM journeyapps/powersync-service:latest

COPY ../../src/service-powersync /powersync

ENV POWERSYNC_CONFIG_PATH=/powersync/config.yaml

ARG PS_POSTGRES_STORAGE_DATABASE_URL
ENV PS_POSTGRES_STORAGE_DATABASE_URL=${PS_POSTGRES_STORAGE_DATABASE_URL}

ARG PS_POSTGRES_REPLICATION_DATABASE_URL
ENV PS_POSTGRES_REPLICATION_DATABASE_URL=${PS_POSTGRES_REPLICATION_DATABASE_URL}

ARG PS_JWKS_URI
ENV PS_JWKS_URI=${PS_JWKS_URI}

EXPOSE 8080

CMD ["start", "-r", "unified"]