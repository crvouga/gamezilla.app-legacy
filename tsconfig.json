{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react",
    "baseUrl": ".",
    "paths": {
      "@libs/utility": ["./src/libs/utility/index"],
      "@libs/components": ["./src/libs/components/index"],
      "@libs/supabase": [
        "./src/libs/supabase/index"
      ],
      "@libs/server-interface": [
        "./src/libs/server-interface/index"
      ],
      "@apps/client/*": ["./src/apps/client/*"],
      "@apps/server/*": [
        "./src/apps/server/*"
      ]
    }
  },
  "include": ["./src", "vite-env.d.ts"],
  "exclude": ["./node_modules"]
}
