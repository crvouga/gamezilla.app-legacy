{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "noFallthroughCasesInSwitch": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@gamezilla/app": ["libs/app/src/index.ts"],
      "@gamezilla/auth": ["libs/auth/src/index.ts"],
      "@gamezilla/chat": ["libs/chat/src/index.ts"],
      "@gamezilla/core": ["libs/core/src/index.ts"],
      "@gamezilla/game-shared": ["libs/game-shared/src/index.ts"],
      "@gamezilla/game/chess": ["libs/game/chess/src/index.ts"],
      "@gamezilla/game/connect-four": ["libs/game/connect-four/src/index.ts"],
      "@gamezilla/game/gomoku": ["libs/game/gomoku/src/index.ts"],
      "@gamezilla/game/maze": ["libs/game/maze/src/index.ts"],
      "@gamezilla/game/shared": ["libs/game-shared/src/index.ts"],
      "@gamezilla/game/snake": ["libs/game/snake/src/index.ts"],
      "@gamezilla/game/tetris": ["libs/game/tetris/src/index.ts"],
      "@gamezilla/game/tic-tac-toe": ["libs/game/tic-tac-toe/src/index.ts"],
      "@gamezilla/home": ["libs/home/src/index.ts"],
      "@gamezilla/party": ["libs/party/src/index.ts"],
      "@gamezilla/profile": ["libs/profile/src/index.ts"],
      "@gamezilla/room": ["libs/room/src/index.ts"],
      "@gamezilla/shared": ["libs/shared/src/index.ts"],
      "@gamezilla/ui": ["libs/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
