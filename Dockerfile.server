# =========================
# Stage 1: Build with Bun
# =========================
FROM alpine:latest AS builder

# Install necessary dependencies
RUN apk add --no-cache curl bash

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash

# Set environment variables for Bun
ENV BUN_INSTALL="/root/.bun"
ENV PATH="$BUN_INSTALL/bin:$PATH"

# Set working directory
WORKDIR /app

# Copy package files first for better caching
COPY package.json bun.lockb* ./

# Install dependencies
RUN bun install

# Copy the rest of the application code
COPY . .

# Build the server
RUN bun server:build

# =========================
# Stage 2: Production Environment
# =========================
FROM alpine:latest

# Install necessary dependencies
RUN apk add --no-cache curl bash

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash

# Set environment variables for Bun
ENV BUN_INSTALL="/root/.bun"
ENV PATH="$BUN_INSTALL/bin:$PATH"

# Set working directory
WORKDIR /app

# Copy built server from the builder stage
COPY --from=builder /app/dist /app/dist
COPY --from=builder /app/bun.lockb /app/package.json /app/

# Install production dependencies (optional, if different)
RUN bun install --production

# Expose the port your server runs on (adjust as needed)
EXPOSE 3000

# Command to run the server
CMD ["bun", "server"]
