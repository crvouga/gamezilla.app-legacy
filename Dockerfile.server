# Use the official Bun image
FROM oven/bun:latest

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json bun.lockb ./

# Install dependencies
RUN bun install

# Copy application code
COPY . .

# Set the DATABASE_URL environment variable
ARG DATABASE_URL

# Build the server
RUN DATABASE_URL=$DATABASE_URL bun server:build

# Expose the port
EXPOSE 3000

# Start the server
CMD ["bun", "server"]