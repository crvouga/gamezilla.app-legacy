{
  "name": "gamezilla.app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backend": "bun src/main/backend.ts",
    "backend:build": "bun db:up",
    "backend:cir-deps": "dpdm --progress --no-warning --no-tree ./src/main/backend.ts",
    "backend:ngrok": "ngrok http 5002 --subdomain=gamezilla",
    "cg": "bun gen:l18n && bun gen:screens && bun gen:events",
    "cg:watch": "bun --watch cg",
    "check": "bun cir-deps && bun x tsc && bun test",
    "check-imports": "bun scripts/check-imports.ts",
    "cir-deps": "bun backend:cir-deps && bun frontend:cir-deps",
    "cloc": "bun x cloc src",
    "db": "bun env && psql \"$DATABASE_URL\"",
    "db:down": "bun x dbmate -e DATABASE_URL down",
    "db:dump": "bun x dbmate dump",
    "db:new": "bun x dbmate new",
    "db:up": "bun x dbmate -e DATABASE_URL up",
    "env": "export $(grep -v '^#' .env | xargs)",
    "format": "bun x prettier --write gamezilla-app",
    "frontend": "bun --bun vite",
    "frontend:build": "vite build",
    "frontend:cir-deps": "dpdm --progress --no-warning --no-tree ./src/main/frontend.tsx",
    "frontend:serve": "bun x serve -s dist -p 3001",
    "gen:events": "bun src/@/events/events-gen.ts",
    "gen:guard": "bun src/@/guards/guards-gen.ts",
    "gen:l18n": "bun src/@/l18n/l18n-gen.ts",
    "gen:screens": "bun src/@/screen/screens-gen.ts",
    "infra:down": "docker-compose -f ./infra/local/docker-compose.yml down",
    "infra:up": "docker-compose -f ./infra/local/docker-compose.yml up -d",
    "powersync:test-client:get": "bun x degit powersync-ja/powersync-service/test-client powersync/test-client",
    "powersync:test-client:build": "cd powersync/test-client && tsc -b",
    "powersync:development-token": "cd powersync/test-client && node dist/bin.js generate-token --config path/to/powersync.yaml --sub test-user",
    "pretty": "bun x sort-package-json && bun x prettier --write .",
    "preview": "bun frontend:build && bun frontend:serve",
    "tc": "bun x tsc --noEmit --watch",
    "test:int": "IS_INTEGRATION_TEST=true bun test",
    "test:unit": "IS_INTEGRATION_TEST=false bun test",
    "viz-bundle": "bun x vite-bundle-visualizer",
    "clean-install": "rm -rf node_modules && rm -rf dist && rm bun.lockb && bun install"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "dependencies": {
    "@electric-sql/client": "^1.0.0-beta.2",
    "@electric-sql/pglite": "^0.2.15",
    "@electric-sql/pglite-sync": "^0.2.17",
    "@journeyapps/wa-sqlite": "^1.2.0",
    "@powersync/web": "^1.12.3",
    "chess.js": "^1.0.0-beta.8",
    "inferno": "^8.2.3",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "postgres": "^3.4.4",
    "preact": "^10.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swiper": "^11.2.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.7",
    "@preact/preset-vite": "^2.7.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "^19.0.0-beta-37ed2a7-20241206",
    "bun-types": "^1.0.11",
    "dpdm": "^3.14.0",
    "fake-indexeddb": "^6.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "6.0.7",
    "vite-plugin-inferno": "^0.0.1",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.4.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": "18.x"
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {},
      "autoprefixer": {}
    }
  }
}
