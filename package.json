{
  "name": "gamezilla.app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/frontend.native.ts",
  "scripts": {
    "all:destroy": "pnpm base --profile all down --volumes",
    "all:down": "pnpm base --profile all down",
    "all:up": "pnpm base --profile all up --build -d",
    "android": "expo run:android",
    "app": "pnpm exec concurrently --names \"FRONTEND,BACKEND\" --prefix-colors \"blue,magenta\" \"pnpm run frontend\" \"pnpm run backend\"",
    "backend": "pnpm run backend:server",
    "backend:rpc": "pnpm exec tsx watch ./src/backend.rpc.ts",
    "backend:topic": "pnpm exec tsx watch ./src/backend.topic.ts",
    "backend:worker": "pnpm exec tsx watch ./src/backend.worker.ts",
    "base": "docker compose -f ./infra/docker-compose.yml --env-file .env",
    "base:down": "pnpm base --profile $PROFILE down",
    "base:up": "pnpm base --profile $PROFILE up --build -d",
    "cg": "pnpm cg:l18n && pnpm cg:screens && pnpm cg:events && pnpm cg:msg-shared",
    "cg:events": "pnpm exec tsx ./src/@/events/events-gen.ts",
    "cg:guard": "pnpm exec tsx ./src/@/guards/guards-gen.ts",
    "cg:l18n": "pnpm exec tsx ./src/@/l18n/l18n-gen.ts",
    "cg:msg-shared": "pnpm exec tsx ./src/@/msg-shared/msg-shared-gen.ts",
    "cg:screens": "pnpm exec tsx ./src/@/screens/screens-gen.ts",
    "cg:watch": "pnpm exec tsx watch cg",
    "check": "pnpm cir-deps && pnpm exec tsc",
    "check-imports": "pnpm exec tsx scripts/check-imports.ts",
    "cir-deps": "pnpm cir-deps:backend-rpc && pnpm cir-deps:backend-topic && pnpm cir-deps:backend-worker && pnpm cir-deps:frontend",
    "cir-deps:backend-rpc": "pnpm exec dpdm --no-warning --no-tree --exit-code circular:1 ./src/backend.rpc.ts",
    "cir-deps:backend-topic": "pnpm exec dpdm --no-warning --no-tree --exit-code circular:1 ./src/backend.topic.ts",
    "cir-deps:backend-worker": "pnpm exec dpdm --no-warning --no-tree --exit-code circular:1 ./src/backend.worker.ts",
    "cir-deps:frontend": "pnpm exec dpdm --no-warning --no-tree --exit-code circular:1 ./src/frontend.web.ts",
    "clean-install": "rm -rf node_modules && rm -rf dist && rm pnpm-lock.yaml && pnpm install",
    "cloc": "pnpm exec cloc src",
    "cloudflare:frontend:build": "NODE_ENV=production pnpm exec vite build",
    "db:down": "pnpm exec dbmate down",
    "db:drop": "pnpm exec dbmate drop",
    "db:dump": "pnpm exec dbmate dump",
    "db:new": "pnpm exec dbmate new",
    "db:up": "pnpm exec dbmate up",
    "docker:prune": "docker system prune -a",
    "docker:stop": "docker stop $(docker ps -aq)",
    "e2e": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test --project=chromium",
    "e2e:ci": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test --project=chromium",
    "e2e:ci:setup": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright install --with-deps chromium",
    "e2e:codegen": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright codegen",
    "e2e:debug": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test --debug",
    "e2e:down": "PROFILE=e2e pnpm base:down",
    "e2e:fast": "pnpm vitest:unit .e2e.ts",
    "e2e:file": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test example",
    "e2e:setup": "pnpm exec playwright install --with-deps",
    "e2e:ui": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test --ui",
    "e2e:up": "PROFILE=e2e pnpm base:up",
    "env:ci": "cp .env.ci .env",
    "env:local": "cp .env.local .env",
    "expo": "expo start --clear",
    "format": "pnpm exec sort-package-json && pnpm exec prettier --write .",
    "format:check": "pnpm exec sort-package-json --check && pnpm exec prettier --check .",
    "frontend": "pnpm exec vite --open",
    "frontend:build": "pnpm exec vite build",
    "frontend:deploy": "curl -d \"\" \"https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/f871839e-b643-4b12-8994-a50777ed620f\"",
    "frontend:preview": "pnpm frontend:build && pnpm exec serve -s dist -p 5173",
    "i": "pnpm install",
    "int": "pnpm vitest:int .test.ts",
    "int:down": "PROFILE=int pnpm base:down",
    "int:up": "PROFILE=int pnpm base:up",
    "ios": "expo run:ios",
    "local": "pnpm env:local && pnpm all:down && pnpm local:up",
    "local:down": "PROFILE=local pnpm base:down",
    "local:up": "PROFILE=local pnpm base:up",
    "pipeline": "act push --workflows .github/workflows/deployment-pipeline.yml --eventpath .github/act/push.json --reuse --secret-file .github/act/secrets",
    "pipeline:clean": "act push --workflows .github/workflows/deployment-pipeline.yml --eventpath .github/act/push.json --cleanup",
    "pipeline:debug": "act push --workflows .github/workflows/deployment-pipeline.yml --eventpath .github/act/push.json --reuse --env-file .env.local",
    "pipeline:dry-run": "act push --workflows .github/workflows/deployment-pipeline.yml --eventpath .github/act/push.json --dryrun",
    "pipeline:job": "act push --workflows .github/workflows/deployment-pipeline.yml --eventpath .github/act/push.json --job",
    "pipeline:list": "act push --workflows .github/workflows/deployment-pipeline.yml --eventpath .github/act/push.json --list",
    "pwa-asset-generator": "npx pwa-asset-generator ./public/assets/logo.blue.svg ./public/pwa-assets --background black --index ./index.html --manifest ./public/manifest.json --path-override /pwa-assets && pnpm exec prettier --write index.html",
    "tc": "pnpm exec tsc --noEmit",
    "unit": "pnpm vitest:unit .test.ts",
    "vitest:coverage": "IS_VITEST_TEST=true NODE_ENV=test vitest run --coverage",
    "vitest:e2e": "IS_VITEST_TEST=true NODE_ENV=test vitest run .e2e.ts",
    "vitest:int": "IS_INTEGRATION_TEST=true IS_VITEST_TEST=true NODE_ENV=test vitest run",
    "vitest:int:coverage": "IS_INTEGRATION_TEST=true IS_VITEST_TEST=true NODE_ENV=test vitest run --coverage",
    "vitest:unit": "IS_VITEST_TEST=true NODE_ENV=test vitest run",
    "viz-bundle": "pnpm exec vite-bundle-visualizer",
    "worker:deploy": "cd src/worker && wrangler deploy",
    "worker:dev": "cd src/worker && wrangler dev",
    "worker:tail": "cd src/worker && wrangler tail"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@expo/metro-runtime": "~5.0.5",
    "@gorhom/portal": "^1.0.14",
    "better-sqlite3": "^12.4.1",
    "chess.js": "^1.4.0",
    "expo": "~53.0.23",
    "expo-audio": "~0.4.9",
    "expo-gl": "~15.1.7",
    "expo-sqlite": "~15.2.14",
    "inferno": "^9.0.4",
    "inferno-create-element": "^9.0.4",
    "postgres": "^3.4.7",
    "preact": "^10.27.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "snabbdom": "^3.6.3",
    "swiper": "^11.2.10",
    "tsx": "^4.20.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@flydotio/dockerfile": "^0.7.10",
    "@happy-dom/global-registrator": "^18.0.1",
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.7.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "cloc": "2.6.0-cloc",
    "concurrently": "^9.2.1",
    "dbmate": "^2.28.0",
    "degit": "^2.8.4",
    "dpdm": "^3.14.0",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "kill-port": "^2.0.1",
    "prettier": "^3.6.2",
    "serve": "^14.2.5",
    "sort-package-json": "^3.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.9",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^3.114.15"
  },
  "packageManager": "pnpm@10.18.3"
}
