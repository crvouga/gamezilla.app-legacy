{
  "name": "gamezilla.app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server": "bun gamezilla-app/main.server.ts",
    "server:build": "bun db:up",
    "server:start": "bun x pm2 start bun --name \"gamezilla-app-server\" -- server -i 3",
    "server:stop": "bun x pm2 stop gamezilla-app-server",
    "server:delete": "bun x pm2 delete gamezilla-app-server",
    "db:up": "bun x dbmate -e DATABASE_URL up",
    "db:down": "bun x dbmate -e DATABASE_URL down",
    "db:start": "docker-compose -f docker-compose.local.yml up -d",
    "db:stop": "docker-compose -f docker-compose.local.yml down",
    "db:new": "bun x dbmate new",
    "db:dump": "bun x dbmate dump",
    "db-prod:connect": "railway connect Postgres",
    "test:int": "IS_INTEGRATION_TEST=true bun test",
    "test:unit": "IS_INTEGRATION_TEST=false bun test",
    "client:build": "vite build",
    "client:serve": "bun x serve -s dist -p 3001",
    "client:cir-deps": "bun x dpdm --progress --no-warning --no-tree ./gamezilla-app/main.client.tsx",
    "server:cir-deps": "bun x dpdm --progress --no-warning --no-tree ./gamezilla-app/main.server.ts",
    "cir-deps": "bun server:cir-deps && bun client:cir-deps",
    "preview": "bun client:build && bun client:serve",
    "client": "vite",
    "tc": "bun x tsc --noEmit --watch",
    "viz-bundle": "bun x vite-bundle-visualizer",
    "check-imports": "bun scripts/check-imports.ts",
    "cloc": "bun x cloc gamezilla-app",
    "pretty": "bun x prettier --write .",
    "gen-events": "bun gamezilla-app/@/events/events-gen.ts",
    "gen-l18n": "bun gamezilla-app/@/l18n/l18n-gen.ts",
    "gen-routes": "bun gamezilla-app/@/routing/routes-gen.ts",
    "gen-guard": "bun gamezilla-app/@/guards/guards-gen.ts",
    "cg": "bun gen-l18n && bun gen-routes && bun gen-events",
    "cg:watch": "bun --watch cg",
    "check": "bun cir-deps && bun x tsc && bun test",
    "format": "bun x prettier --write gamezilla-app"
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.6",
    "inferno": "^8.2.3",
    "pg": "^8.11.5",
    "preact": "^10.19.3",
    "react": "rc",
    "react-dom": "rc",
    "redis": "^4.6.13",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "solid-js": "^1.8.17",
    "swiper": "^11.1.1",
    "tailwind-merge": "^2.4.0",
    "vue": "^3.4.30"
  },
  "devDependencies": {
    "@biomejs/biome": "1.7.2",
    "@happy-dom/global-registrator": "^14.7.1",
    "@preact/preset-vite": "^2.7.0",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@types/pg": "^8.11.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "babel-plugin-inferno": "^6.7.1",
    "babel-plugin-react-compiler": "^0.0.0-experimental-938cd9a-20240601",
    "babel-preset-es2015": "^6.24.1",
    "bun-types": "^1.0.11",
    "csv-parser": "^3.0.0",
    "eslint": "^9.1.1",
    "eslint-plugin-solid": "^0.14.0",
    "postcss": "^8.4.23",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.4.2",
    "vite": "5.2.8",
    "vite-plugin-inferno": "^0.0.1",
    "vite-plugin-solid": "^2.10.2",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "engines": {
    "node": "18.x"
  }
}
