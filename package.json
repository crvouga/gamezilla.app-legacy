{
  "name": "gamezilla",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": "v14.17.6",
    "yarn": "1.22.4"
  },
  "scripts": {
    "dev": "concurrently \"yarn client:dev\" \"yarn server:dev\"",
    "build": "concurrently \"yarn server:build\" \"yarn client:build\"",
    "start": "yarn server:start",
    "postinstall": "yarn build",
    "client:dev": "cd client && vite",
    "client:build": "cd client && vite build",
    "client:serve": "cd client && vite preview",
    "client:check": "cd client && svelte-check --tsconfig ./tsconfig.json",
    "server:dev": "cd server && PORT=5000 npx nodemon src/main.ts",
    "server:start": "cd server && node build/main.js",
    "server:build": "cd server && tsc",
    "heroku:logs": "heroku logs --tail --app gamezilla",
    "heroku:local": "yarn && heroku local",
    "heroku:env": "heroku config -s -a gamezilla > .env"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^1.0.0-next.11",
    "@tsconfig/svelte": "^2.0.1",
    "@types/node": "^16.11.11",
    "concurrently": "^6.4.0",
    "svelte": "^3.37.0",
    "svelte-check": "^2.1.0",
    "svelte-preprocess": "^4.7.2",
    "ts-node": "^10.4.0",
    "tslib": "^2.0.0",
    "typescript": "^4.5.2",
    "vite": "^2.6.14"
  },
  "dependencies": {
    "@supabase/supabase-js": "^1.28.5",
    "dotenv": "^10.0.0",
    "fastify": "^3.24.1",
    "fastify-static": "^4.5.0"
  }
}
