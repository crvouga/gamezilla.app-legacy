{
  "name": "gamezilla.app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server-prod": "bun db-prod:up &&  bun gamezilla/gamezilla.server.ts",
    "db-prod:up": "dbmate -e DATABASE_URL_PROD up",
    "server": "bun gamezilla/gamezilla.server.ts",
    "db:up": "dbmate -e DATABASE_URL up",
    "client:build": "vite build",
    "client:serve": "bun x serve -s dist -p 3000",
    "client:preview": "bun client:build && bun client:serve",
    "client": "vite",
    "ngrok": "ngrok start --all",
    "tc": "bun x tsc --noEmit --watch",
    "viz-bundle": "bun x vite-bundle-visualizer",
    "cir-deps": "bun x dpdm --progress --no-warning --no-tree ./gamezilla/gamezilla.client.tsx",
    "check-imports": "bun scripts/check-imports.ts"
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.6",
    "inferno": "^8.2.3",
    "postgres": "^3.4.3"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^5.57.1",
    "autoprefixer": "^10.4.14",
    "bun-types": "^1.0.11",
    "csv-parser": "^3.0.0",
    "eslint": "^8.38.0",
    "postcss": "^8.4.23",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.3.2",
    "typescript": "latest",
    "vite": "^5.0.0",
    "vite-plugin-inferno": "^0.0.1",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "engines": {
    "node": "18.x"
  }
}
