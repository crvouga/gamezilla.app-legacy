{
  "name": "gamezilla.app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backend": "npm run backend-primary",
    "backend-edge": "NODE_ENV=development npx tsx watch ./src/backend-edge.ts",
    "backend-edge:railway": "NODE_ENV=production npx tsx ./src/backend-edge.ts",
    "backend-primary": "NODE_ENV=development npx tsx watch ./src/backend-primary.ts",
    "backend-primary:railway": "NODE_ENV=production npx tsx ./src/backend-primary.ts",
    "cg": "npm run cg:l18n && npm run cg:screens && npm run cg:events && npm run cg:msg-shared",
    "cg:events": "npx tsx ./src/@/events/events-gen.ts",
    "cg:guard": "npx tsx ./src/@/guards/guards-gen.ts",
    "cg:l18n": "npx tsx ./src/@/l18n/l18n-gen.ts",
    "cg:msg-shared": "npx tsx ./src/@/msg-shared/msg-shared-gen.ts",
    "cg:screens": "npx tsx ./src/@/screen/screens-gen.ts",
    "cg:watch": "npx tsx watch cg",
    "check": "npm run cir-deps && npx tsc",
    "check-imports": "npx tsx scripts/check-imports.ts",
    "cir-deps": "npm run cir-deps:backend-primary && npm run cir-deps:frontend",
    "cir-deps:backend-primary": "npx dpdm --progress --no-warning --no-tree ./src/backend-primary.ts",
    "cir-deps:frontend": "npx dpdm --progress --no-warning --no-tree ./src/frontend.tsx",
    "clean-install": "rm -rf node_modules && rm -rf dist && rm package-lock.json && npm install --legacy-peer-deps",
    "cloc": "npx cloc src",
    "db": "psql postgresql://postgres:postgres@localhost:5438/postgres?sslmode=disable",
    "db:down": "npx dbmate down",
    "db:dump": "npx dbmate dump",
    "db:new": "npx dbmate new",
    "db:up": "npx dbmate up",
    "frontend": "NODE_ENV=development npx vite",
    "frontend:build": "NODE_ENV=development npx vite build",
    "frontend:build:vercel": "NODE_ENV=production npx vite build",
    "frontend:preview": "npm run frontend:build && npx serve -s dist -p 5173",
    "i": "npm i --legacy-peer-deps",
    "infra:down": "docker compose --profile test --env-file .env.local -f ./infra/local/docker-compose.yml down",
    "infra:up": "docker compose --env-file .env.local -f ./infra/local/docker-compose.yml up --build -d",
    "infra:up:test": "docker compose --profile test --env-file .env.local -f ./infra/local/docker-compose.yml up --build -d",
    "kp": "npx kill-port 5002 && npx kill-port 8088 && npx kill-port $PORT",
    "powersync:development-token": "cd powersync/test-client && node dist/bin.js generate-token --config path/to/powersync.yaml --sub test-user",
    "powersync:test-client:build": "cd powersync/test-client && tsc -b",
    "powersync:test-client:get": "npx degit powersync-ja/powersync-service/test-client powersync/test-client",
    "pretty": "npx sort-package-json && npx prettier --write .",
    "tc": "npx tsc --noEmit --watch",
    "test": "npm run test:vitest",
    "test:coverage": "npm run test:vitest:coverage",
    "test:e2e": "npm run test:playwright",
    "test:e2e:setup": "npm run test:playwright:setup",
    "test:e2e:ui": "npm run test:playwright:ui",
    "test:int": "npm run test:vitest:int",
    "test:int:coverage": "npm run test:vitest:int:coverage",
    "test:playwright": "IS_PLAYWRIGHT_TEST=true npx playwright test",
    "test:playwright:chromium": "IS_PLAYWRIGHT_TEST=true npx playwright test --project=chromium",
    "test:playwright:codegen": "IS_PLAYWRIGHT_TEST=true npx playwright codegen",
    "test:playwright:debug": "IS_PLAYWRIGHT_TEST=true npx playwright test --debug",
    "test:playwright:file": "IS_PLAYWRIGHT_TEST=true npx playwright test example",
    "test:playwright:setup": "npx playwright install --with-deps",
    "test:playwright:ui": "IS_PLAYWRIGHT_TEST=true npx playwright test --ui",
    "test:vitest": "IS_VITEST_TEST=true NODE_ENV=test vitest run",
    "test:vitest:coverage": "IS_VITEST_TEST=true NODE_ENV=test vitest run --coverage",
    "test:vitest:int": "IS_INTEGRATION_TEST=true IS_VITEST_TEST=true NODE_ENV=test vitest run",
    "test:vitest:int:coverage": "IS_INTEGRATION_TEST=true IS_VITEST_TEST=true NODE_ENV=test vitest run --coverage",
    "viz-bundle": "npx vite-bundle-visualizer"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "dependencies": {
    "@journeyapps/wa-sqlite": "^1.2.5",
    "@powersync/web": "^1.22.0",
    "argon2": "^0.43.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "chess.js": "^1.0.0-beta.8",
    "compression": "^1.7.5",
    "inferno": "^9.0.1",
    "inferno-create-element": "^9.0.3",
    "postgres": "^3.4.4",
    "preact": "^10.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swiper": "^11.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^18.0.1",
    "@playwright/test": "^1.53.2",
    "@tailwindcss/vite": "^4.1.6",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.8",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "dpdm": "^3.14.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^3.2.4"
  }
}
