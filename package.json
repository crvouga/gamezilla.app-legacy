{
  "name": "gamezilla",
  "version": "1.0.0",
  "private": true,
  "license": "",
  "scripts": {
    "check": "tsc -w",
    "postinstall": "yarn backend:build",
    "heroku-postbuild": "yarn frontend:build",
    "backend:dev": "cd build/Backend && nodemon main.js",
    "backend:build": "cd src/Backend && tsc --build",
    "backend:start": "cd build/Backend && node main.js",
    "frontend:dev": "parcel --dist-dir build/Frontend src/Frontend/index.html",
    "frontend:build": "parcel build --dist-dir build/Frontend src/Frontend/index.html",
    "heroku:env": "heroku config -s -a gamezilla > .env",
    "heroku:start": "yarn backend:start",
    "heroku:preview": "yarn && yarn heroku-postbuild && yarn heroku:start "
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.4.0",
    "@types/express": "^4.17.13",
    "@types/node": "17.0.8",
    "@types/react": "17.0.38",
    "@types/react-dom": "^17.0.11",
    "autoprefixer": "^10.4.2",
    "nodemon": "^2.0.15",
    "parcel": "^2.2.0",
    "postcss": "^8.4.5",
    "tailwindcss": "^3.0.14",
    "tslib": "^2.0.0",
    "typescript": "4.5.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^1.29.1",
    "express": "^4.17.2",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-router-dom": "6"
  }
}
