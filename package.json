{
  "name": "gamezilla.app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "npx vite build && npx dbmate --no-dump-schema -e DATABASE_URL_PROD up && npx tsx gamezilla-app/gamezilla-app.server.ts",
    "db-prod:migrate:up": "dbmate -e DATABASE_URL_PROD up",
    "db-prod:dump": "dbmate -e DATABASE_URL_PROD dump",
    "server": "bun gamezilla-app/gamezilla-app.server.ts",
    "db:migrate:up": "dbmate -e DATABASE_URL up",
    "db:migrate:down": "dbmate -e DATABASE_URL down",
    "db:up": "docker-compose -f docker-compose.local.yml up -d",
    "db:down": "docker-compose -f docker-compose.local.yml down",
    "db:new": "dbmate new",
    "db:dump": "dbmate dump",
    "client:build": "vite build",
    "client:serve": "bun x serve -s dist -p 3000",
    "client:preview": "bun client:build && bun client:serve",
    "client": "vite",
    "ngrok": "ngrok start --all",
    "ngrok:config:edit": "ngrok config edit",
    "tc": "bun x tsc --noEmit --watch",
    "viz-bundle": "bun x vite-bundle-visualizer",
    "cir-deps": "bun x dpdm --progress --no-warning --no-tree ./gamezilla-app/gamezilla.client.tsx",
    "check-imports": "bun scripts/check-imports.ts",
    "cloc": "bun x cloc gamezilla",
    "pretty": "bun x prettier --write ."
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.6",
    "dotenv": "^16.4.5",
    "inferno": "^8.2.3",
    "postgres": "^3.4.3",
    "preact": "^10.19.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "redis": "^4.6.12",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^13.3.8",
    "@preact/preset-vite": "^2.7.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/parser": "^5.57.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.14",
    "babel-plugin-inferno": "^6.7.1",
    "babel-preset-es2015": "^6.24.1",
    "bun-types": "^1.0.11",
    "csv-parser": "^3.0.0",
    "eslint": "^8.38.0",
    "postcss": "^8.4.23",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.3.2",
    "ts-plugin-inferno": "^6.0.3",
    "typescript": "latest",
    "vite": "^5.0.0",
    "vite-plugin-inferno": "^0.0.1",
    "vite-tsconfig-paths": "^4.2.1"
  },
  "engines": {
    "node": "18.x"
  }
}
