{
  "name": "svelte-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "backend:dev": "cd build/Backend && nodemon main.js",
    "backend:build": "cd src/Backend && tsc",
    "backend:start": "cd build/Backend && node main.js",
    "backend:check": "cd src/Backend && tsc -w",
    "postinstall": "yarn backend:build",
    "heroku-postbuild": "yarn frontend-svelte:build",
    "frontend-svelte:dev": "rollup -c -w",
    "frontend-svelte:build": "rollup -c",
    "frontend-svelte:check": "cd src/FrontendSvelte  && svelte-check --tsconfig ./tsconfig.json --watch",
    "frontend-react:dev": "npx parcel --dist-dir build/FrontendReact src/FrontendReact/index.html",
    "frontend-react:build": "npx parcel build --dist-dir build/FrontendReact src/index.html",
    "frontend-react:check": "cd src/FrontendReact && tsc -w",
    "load-env": "heroku config -s -a gamezilla > .env"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^17.0.0",
    "@rollup/plugin-node-resolve": "^11.0.0",
    "@rollup/plugin-typescript": "^8.0.0",
    "@tsconfig/svelte": "^2.0.0",
    "@types/express": "^4.17.13",
    "nodemon": "^2.0.15",
    "rollup": "^2.3.4",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.0.0",
    "rollup-plugin-terser": "^7.0.0",
    "svelte": "^3.0.0",
    "svelte-check": "^2.0.0",
    "svelte-preprocess": "^4.0.0",
    "tslib": "^2.0.0",
    "@types/node": "17.0.8",
    "@types/react": "17.0.38",
    "@types/react-dom": "^17.0.11",
    "autoprefixer": "^10.4.2",
    "eslint": "8.6.0",
    "eslint-config-next": "12.0.8",
    "parcel": "^2.2.0",
    "postcss": "^8.4.5",
    "tailwindcss": "^3.0.14",
    "typescript": "4.5.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^1.29.1",
    "express": "^4.17.2",
    "react": "17.0.2",
    "react-dom": "17.0.2"
  }
}
