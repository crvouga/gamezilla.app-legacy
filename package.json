{
  "name": "gamezilla.app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cg": "bun gen:l18n && bun gen:routes && bun gen:events",
    "cg:watch": "bun --watch cg",
    "check": "bun cir-deps && bun x tsc && bun test",
    "check-imports": "bun scripts/check-imports.ts",
    "cir-deps": "bun server:cir-deps && bun client:cir-deps",
    "client": "vite",
    "client:build": "vite build",
    "client:cir-deps": "bun x dpdm --progress --no-warning --no-tree ./src/main.client.tsx",
    "client:serve": "bun x serve -s dist -p 3001",
    "cloc": "bun x cloc src",
    "env": "export $(grep -v '^#' .env | xargs)",
    "db": "bun env && psql \"$DATABASE_URL\"",
    "db:down": "bun x dbmate -e DATABASE_URL down",
    "db:dump": "bun x dbmate dump",
    "db:new": "bun x dbmate new",
    "db:start": "docker-compose -f db/docker-compose.local.yml up -d",
    "db:stop": "docker-compose -f db/docker-compose.local.yml down",
    "db:up": "bun x dbmate -e DATABASE_URL up",
    "format": "bun x prettier --write gamezilla-app",
    "gen:events": "bun src/@/events/events-gen.ts",
    "gen:guard": "bun src/@/guards/guards-gen.ts",
    "gen:l18n": "bun src/@/l18n/l18n-gen.ts",
    "gen:routes": "bun src/@/routing/routes-gen.ts",
    "load-balancer": "bun src/main.load-balancer.ts",
    "pretty": "bun x prettier --write .",
    "preview": "bun client:build && bun client:serve",
    "server": "bun src/main.server.ts",
    "server:build": "bun db:up",
    "server:cir-deps": "bun x dpdm --progress --no-warning --no-tree ./src/main.server.ts",
    "tc": "bun x tsc --noEmit --watch",
    "test:int": "IS_INTEGRATION_TEST=true bun test",
    "test:unit": "IS_INTEGRATION_TEST=false bun test",
    "viz-bundle": "bun x vite-bundle-visualizer"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.8",
    "inferno": "^8.2.3",
    "ioredis": "^5.4.1",
    "postgres": "^3.4.4",
    "preact": "^10.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swiper": "^11.1.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.7",
    "@preact/preset-vite": "^2.7.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "^19.0.0-beta-37ed2a7-20241206",
    "bun-types": "^1.0.11",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.2",
    "vite": "^6.0.3",
    "vite-plugin-compression2": "^1.3.3",
    "vite-plugin-inferno": "^0.0.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": "18.x"
  }
}
