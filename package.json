{
  "name": "gamezilla",
  "version": "1.0.0",
  "private": true,
  "license": "",
  "scripts": {
    "watch": "tsc -w",
    "postinstall": "yarn server:build",
    "heroku-postbuild": "yarn client:build",
    "server:dev": "cd build/server && nodemon main.js",
    "server:build": "cd src/server && tsc --build",
    "server:start": "cd build/server && node main.js",
    "client:dev": "parcel --dist-dir build/client src/client/index.html",
    "client:build": "parcel build --dist-dir build/client src/client/index.html",
    "heroku:env": "heroku config -s -a gamezilla > .env",
    "heroku:start": "yarn server:start",
    "heroku:preview": "yarn && yarn heroku-postbuild && yarn heroku:start "
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.4.0",
    "@types/express": "^4.17.13",
    "@types/node": "17.0.8",
    "@types/react": "17.0.38",
    "@types/react-dom": "^17.0.11",
    "autoprefixer": "^10.4.2",
    "nodemon": "^2.0.15",
    "parcel": "^2.2.0",
    "postcss": "^8.4.5",
    "tailwindcss": "^3.0.14",
    "tslib": "^2.0.0",
    "typescript": "4.5.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^1.29.1",
    "express": "^4.17.2",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-location": "^3.3.3",
    "react-query": "^3.34.11"
  }
}
