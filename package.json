{
  "name": "gamezilla.app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "app": "pnpm exec concurrently \"pnpm run backend-primary\" \"pnpm run frontend\"",
    "backend": "pnpm backend-primary",
    "backend-edge": "NODE_ENV=development pnpm exec tsx watch ./src/backend-edge.ts",
    "backend-primary": "NODE_ENV=development pnpm exec tsx watch ./src/backend-primary.ts",
    "cg": "pnpm cg:l18n && pnpm cg:screens && pnpm cg:events && pnpm cg:msg-shared",
    "cg:events": "pnpm exec tsx ./src/@/events/events-gen.ts",
    "cg:guard": "pnpm exec tsx ./src/@/guards/guards-gen.ts",
    "cg:l18n": "pnpm exec tsx ./src/@/l18n/l18n-gen.ts",
    "cg:msg-shared": "pnpm exec tsx ./src/@/msg-shared/msg-shared-gen.ts",
    "cg:screens": "pnpm exec tsx ./src/@/screen/screens-gen.ts",
    "cg:watch": "pnpm exec tsx watch cg",
    "check": "pnpm cir-deps && pnpm exec tsc",
    "check-imports": "pnpm exec tsx scripts/check-imports.ts",
    "cir-deps": "pnpm cir-deps:backend-primary && pnpm cir-deps:backend-edge && pnpm cir-deps:frontend",
    "cir-deps:backend-edge": "pnpm exec dpdm --progress --no-warning --no-tree ./src/backend-edge.ts",
    "cir-deps:backend-primary": "pnpm exec dpdm --progress --no-warning --no-tree ./src/backend-primary.ts",
    "cir-deps:frontend": "pnpm exec dpdm --progress --no-warning --no-tree ./src/frontend.ts",
    "clean-install": "rm -rf node_modules && rm -rf dist && rm pnpm-lock.yaml && pnpm install",
    "cloc": "pnpm exec cloc src",
    "db": "psql postgresql://postgres:postgres@localhost:5438/postgres?sslmode=disable",
    "db:down": "pnpm exec dbmate down",
    "db:dump": "pnpm exec dbmate dump",
    "db:new": "pnpm exec dbmate new",
    "db:up": "pnpm exec dbmate up",
    "frontend": "NODE_ENV=development pnpm exec vite",
    "frontend:build": "NODE_ENV=development pnpm exec vite build",
    "frontend:build:vercel": "NODE_ENV=production pnpm exec vite build",
    "frontend:preview": "pnpm frontend:build && pnpm exec serve -s dist -p 5173",
    "i": "pnpm install",
    "infra:down": "docker compose --profile test --env-file .env.local -f ./infra/docker-compose.yml down",
    "infra:up": "docker compose --env-file .env.local -f ./infra/docker-compose.yml up --build -d",
    "infra:up:test": "docker compose --profile test --env-file .env.local -f ./infra/docker-compose.yml up --build -d",
    "kp": "pnpm exec kill-port 5002 && pnpm exec kill-port 8088 && pnpm exec kill-port $PORT",
    "powersync:development-token": "cd powersync/test-client && node dist/bin.js generate-token --config path/to/powersync.yaml --sub test-user",
    "powersync:test-client:build": "cd powersync/test-client && tsc -b",
    "powersync:test-client:get": "pnpm exec degit powersync-ja/powersync-service/test-client powersync/test-client",
    "pretty": "pnpm exec sort-package-json && pnpm exec prettier --write .",
    "tc": "pnpm exec tsc --noEmit --watch",
    "test": "pnpm test:vitest",
    "test:coverage": "pnpm test:vitest:coverage",
    "test:e2e": "pnpm test:playwright",
    "test:e2e:ci": "pnpm test:playwright:ci",
    "test:e2e:ci:setup": "pnpm test:playwright:ci:setup",
    "test:e2e:setup": "pnpm test:playwright:setup",
    "test:e2e:ui": "pnpm test:playwright:ui",
    "test:int": "pnpm test:vitest:int",
    "test:int:coverage": "pnpm test:vitest:int:coverage",
    "test:playwright": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test --project=chromium",
    "test:playwright:ci": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test --project=chromium",
    "test:playwright:ci:setup": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright install --with-deps chromium",
    "test:playwright:codegen": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright codegen",
    "test:playwright:debug": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test --debug",
    "test:playwright:file": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test example",
    "test:playwright:setup": "pnpm exec playwright install --with-deps",
    "test:playwright:ui": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test --ui",
    "test:vitest": "IS_VITEST_TEST=true NODE_ENV=test vitest run",
    "test:vitest:coverage": "IS_VITEST_TEST=true NODE_ENV=test vitest run --coverage",
    "test:vitest:int": "IS_INTEGRATION_TEST=true IS_VITEST_TEST=true NODE_ENV=test vitest run",
    "test:vitest:int:coverage": "IS_INTEGRATION_TEST=true IS_VITEST_TEST=true NODE_ENV=test vitest run --coverage",
    "viz-bundle": "pnpm exec vite-bundle-visualizer"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "dependencies": {
    "@journeyapps/wa-sqlite": "^1.2.5",
    "@powersync/common": "^1.33.0",
    "@powersync/web": "^1.22.0",
    "argon2": "^0.43.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "chess.js": "^1.0.0-beta.8",
    "compression": "^1.7.5",
    "hyperapp": "^2.0.22",
    "inferno": "^9.0.1",
    "inferno-create-element": "^9.0.3",
    "postgres": "^3.4.4",
    "preact": "^10.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "snabbdom": "^3.6.2",
    "swiper": "^11.2.0",
    "tsx": "^4.20.3",
    "workbox-window": "^7.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^18.0.1",
    "@playwright/test": "^1.53.2",
    "@tailwindcss/vite": "^4.1.6",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.8",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "cloc": "2.6.0-cloc",
    "concurrently": "^9.2.0",
    "dbmate": "^2.27.0",
    "degit": "^2.8.4",
    "dpdm": "^3.14.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "kill-port": "^2.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "serve": "^14.2.4",
    "sort-package-json": "^3.3.1",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-pwa": "^1.0.1",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^3.2.4"
  }
}
