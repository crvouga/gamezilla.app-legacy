{
  "name": "gamezilla",
  "version": "1.0.0",
  "private": true,
  "license": "",
  "scripts": {
    "watch": "tsc -w",
    "postinstall": "npm run server:build",
    "heroku-postbuild": "npm run client:build",
    "server:dev": "cd .builds/server && nodemon main.js",
    "server:build": "cd src/server && tsc --build",
    "server:start": "cd .builds/server && node main.js",
    "client:dev": "parcel --dist-dir .builds/client src/client/main.html",
    "client:build": "parcel build --dist-dir .builds/client src/client/main.html",
    "heroku:env": "heroku config -s -a gamezilla > .env",
    "heroku:start": "npm run server:start",
    "heroku:preview": "npm install && npm run heroku-postbuild && npm run heroku:start "
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/node": "17.0.8",
    "@types/react": "17.0.38",
    "@types/react-dom": "^17.0.11",
    "autoprefixer": "^10.4.2",
    "nodemon": "^2.0.15",
    "parcel": "^2.2.0",
    "tslib": "^2.0.0",
    "typescript": "4.5.4"
  },
  "dependencies": {
    "@emotion/react": "^11.7.1",
    "@emotion/styled": "^11.6.0",
    "@mui/icons-material": "^5.3.1",
    "@mui/material": "^5.3.1",
    "@supabase/supabase-js": "^1.29.1",
    "express": "^4.17.2",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-location": "^3.3.3",
    "react-query": "^3.34.11"
  }
}
