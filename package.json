{
  "name": "gamezilla.app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backend": "bun backend-primary",
    "backend-edge": "PROD=false PROD=false bun --watch ./src/backend-edge.ts",
    "backend-edge:railway": "PROD=true bun ./src/backend-edge.ts",
    "backend-primary": "PROD=false bun --watch ./src/backend-primary.ts",
    "backend-primary:railway": "PROD=true bun ./src/backend-primary.ts",
    "backend:cir-deps": "bun x dpdm --progress --no-warning --no-tree ./src/backend.ts",
    "cg": "bun cg:l18n && bun cg:screens && bun cg:events && bun cg:msg-shared",
    "cg:events": "bun ./src/@/events/events-gen.ts",
    "cg:guard": "bun ./src/@/guards/guards-gen.ts",
    "cg:l18n": "bun ./src/@/l18n/l18n-gen.ts",
    "cg:msg-shared": "bun ./src/@/msg-shared/msg-shared-gen.ts",
    "cg:screens": "bun ./src/@/screen/screens-gen.ts",
    "cg:watch": "bun --watch cg",
    "check": "bun cir-deps && bun x tsc",
    "check-imports": "bun scripts/check-imports.ts",
    "cir-deps": "bun backend:cir-deps && bun frontend:cir-deps",
    "clean-install": "rm -rf node_modules && rm -rf dist && rm bun.lock && bun install",
    "cloc": "bun x cloc src",
    "db": "psql postgresql://postgres:postgres@localhost:5438/postgres?sslmode=disable",
    "db:down": "bun x dbmate -e DATABASE_URL down",
    "db:dump": "bun x dbmate dump",
    "db:new": "bun x dbmate new",
    "db:up": "bun x dbmate -e DATABASE_URL up",
    "dir:reset": "rm -rf .env && [ -f .env.example ] && cp .env.example .env && bun install || true",
    "dir:reset:hard": "rm -rf dist node_modules bun.lock && bun dir:reset",
    "docker:down": "docker compose --env-file .env -f ./infra/docker/docker-compose.yml down",
    "docker:rebuild": "docker compose --env-file .env -f ./infra/docker/docker-compose.yml build --no-cache",
    "docker:up": "docker compose --env-file .env -f ./infra/docker/docker-compose.yml up -d",
    "env": "export $(grep -v '^#' .env.test | xargs)",
    "frontend": "vite",
    "frontend:build": "bun x vite build",
    "frontend:serve": "bun x serve -s dist -p 3001",
    "infra:build": "docker compose --env-file .env -f ./infra/local/docker-compose.yml build --no-cache",
    "infra:cmd": "docker compose --env-file .env -f ./infra/local/docker-compose.yml exec",
    "infra:down": "docker compose --env-file .env -f ./infra/local/docker-compose.yml down",
    "infra:restart": "docker compose --env-file .env -f ./infra/local/docker-compose.yml restart",
    "infra:up": "bun dir:reset && docker compose --env-file .env -f ./infra/local/docker-compose.yml up --build -d",
    "kp": "bun x kill-port 5002 && bun x kill-port 8088 && bun x kill-port $PORT",
    "playwright:codegen": "bun x --bun playwright codegen",
    "playwright:test": "bun x --bun playwright test",
    "playwright:test-chromium": "bun x --bun playwright test --project=chromium",
    "playwright:test-debug": "bun x --bun playwright test --debug",
    "playwright:test-file": "bun x --bun playwright test example",
    "playwright:test-ui": "bun x --bun playwright test --ui",
    "powersync:development-token": "cd powersync/test-client && node dist/bin.js generate-token --config path/to/powersync.yaml --sub test-user",
    "powersync:test-client:build": "cd powersync/test-client && tsc -b",
    "powersync:test-client:get": "bun x degit powersync-ja/powersync-service/test-client powersync/test-client",
    "pretty": "bun x sort-package-json && bun x prettier --write .",
    "preview": "bun frontend:build && bun frontend:serve",
    "tc": "bun x tsc --noEmit --watch",
    "test": "bun test:unit",
    "test:clear-only": "bun x replace-in-files-cli '**/*.ts' '**/*.tsx' --string='.only(' --replacement='('",
    "test:int": "IS_INTEGRATION_TEST=true bun test",
    "test:unit": "IS_INTEGRATION_TEST=false bun test",
    "viz-bundle": "bun x vite-bundle-visualizer"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "@powersync/web": "^1.22.0",
    "@vercel/speed-insights": "^1.2.0",
    "chess.js": "^1.0.0-beta.8",
    "inferno": "^9.0.1",
    "postgres": "^3.4.4",
    "preact": "^10.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swiper": "^11.2.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^18.0.1",
    "@playwright/test": "^1.53.1",
    "@preact/preset-vite": "^2.7.0",
    "@tailwindcss/vite": "^4.1.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.7",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-plugin-react-compiler": "^19.0.0-beta-37ed2a7-20241206",
    "bun-types": "^1.0.11",
    "dpdm": "^3.14.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.7.3",
    "vite": "6.0.7",
    "vite-plugin-inferno": "^0.0.1",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.4.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": "22.x"
  }
}
