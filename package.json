{
  "name": "next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "server:build": "echo 'server build'",
    "server": "tsx --tsconfig ./tsconfig.json src/apps/server/main.ts",
    "server:watch": "tsx watch src/apps/server/main.ts",
    "client:build": "tsc && vite build",
    "client": "vite",
    "ngrok": "ngrok start --all",
    "db:dev": "pscale connect gamezilla dev",
    "tc": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@supabase/supabase-js": "^1.30.0",
    "chess.js": "^1.0.0-beta.6",
    "chessboard-element": "^1.2.0",
    "mysql2": "^3.2.0",
    "preact": "^10.16.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.5.1",
    "socket.io-client": "^4.5.1",
    "threads": "^1.7.0",
    "zod": "^3.20.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.5.0",
    "@types/chessboardjs": "^0.3.2",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "autoprefixer": "^10.4.14",
    "csv-parser": "^3.0.0",
    "eslint": "^8.38.0",
    "jest": "^29.5.0",
    "postcss": "^8.4.23",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.3.2",
    "tsx": "^3.12.7",
    "typescript": "^5.0.2",
    "vite": "^4.3.2",
    "vite-tsconfig-paths": "^4.2.0"
  },
  "engines": {
    "node": ">=16.14"
  }
}
