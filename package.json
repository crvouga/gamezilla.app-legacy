{
  "name": "gamezilla.app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/frontend.native.ts",
  "scripts": {
    "app": "pnpm exec concurrently \"pnpm run frontend\" \"pnpm run topic\" \"pnpm run backend\"",
    "backend": "pnpm exec tsx watch ./src/backend.ts",
    "cg": "pnpm cg:l18n && pnpm cg:screens && pnpm cg:events && pnpm cg:msg-shared",
    "cg:events": "pnpm exec tsx ./src/@/events/events-gen.ts",
    "cg:guard": "pnpm exec tsx ./src/@/guards/guards-gen.ts",
    "cg:l18n": "pnpm exec tsx ./src/@/l18n/l18n-gen.ts",
    "cg:msg-shared": "pnpm exec tsx ./src/@/msg-shared/msg-shared-gen.ts",
    "cg:screens": "pnpm exec tsx ./src/@/screens/screens-gen.ts",
    "cg:watch": "pnpm exec tsx watch cg",
    "check": "pnpm cir-deps && pnpm exec tsc",
    "check-imports": "pnpm exec tsx scripts/check-imports.ts",
    "cir-deps": "pnpm cir-deps:backend && pnpm cir-deps:topic && pnpm cir-deps:frontend",
    "cir-deps:backend": "pnpm exec dpdm --no-warning --no-tree --exit-code circular:1 ./src/backend.ts",
    "cir-deps:frontend": "pnpm exec dpdm --no-warning --no-tree --exit-code circular:1 ./src/frontend.ts",
    "cir-deps:topic": "pnpm exec dpdm --no-warning --no-tree --exit-code circular:1 ./src/topic.ts",
    "clean-install": "rm -rf node_modules && rm -rf dist && rm pnpm-lock.yaml && pnpm install",
    "cloc": "pnpm exec cloc src",
    "db:down": "pnpm exec dbmate down",
    "db:drop": "pnpm exec dbmate drop",
    "db:dump": "pnpm exec dbmate dump",
    "db:new": "pnpm exec dbmate new",
    "db:up": "pnpm exec dbmate up",
    "docker:down": "docker stop $(docker ps -aq) && docker compose --env-file .env --profile ci --profile e2e -f ./infra/docker-compose.yml down",
    "e2e": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test --project=chromium",
    "e2e:ci": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test --project=chromium",
    "e2e:ci:setup": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright install --with-deps chromium",
    "e2e:codegen": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright codegen",
    "e2e:debug": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test --debug",
    "e2e:down": "docker compose --env-file .env --profile e2e -f ./infra/docker-compose.yml down",
    "e2e:file": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test example",
    "e2e:setup": "pnpm exec playwright install --with-deps",
    "e2e:ui": "IS_PLAYWRIGHT_TEST=true pnpm exec playwright test --ui",
    "e2e:up": "docker compose --profile e2e -f ./infra/docker-compose.yml --env-file .env up --build -d",
    "env:ci": "cp .env.ci .env",
    "env:local": "cp .env.local .env",
    "expo": "expo start",
    "format": "pnpm exec sort-package-json && pnpm exec prettier --write .",
    "frontend": "pnpm exec vite --open",
    "frontend:build": "pnpm exec vite build",
    "frontend:preview": "pnpm frontend:build && pnpm exec serve -s dist -p 5173",
    "github-action-runners:down": "docker compose --env-file github-actions/.env -f github-actions/docker-compose.yml down",
    "github-action-runners:up": "docker compose --env-file github-actions/.env -f github-actions/docker-compose.yml up -d --build",
    "i": "pnpm install",
    "int": "pnpm vitest:int",
    "local:destroy": "pnpm local:down --volumes",
    "local:down": "docker compose --profile ci -f ./infra/docker-compose.yml --env-file .env down",
    "local:up": "docker compose -f ./infra/docker-compose.yml --env-file .env up --build -d",
    "tc": "pnpm exec tsc --noEmit --watch",
    "topic": "pnpm exec tsx watch ./src/topic.ts",
    "unit": "pnpm vitest",
    "vitest": "IS_VITEST_TEST=true NODE_ENV=test vitest run",
    "vitest:coverage": "IS_VITEST_TEST=true NODE_ENV=test vitest run --coverage",
    "vitest:e2e": "IS_VITEST_TEST=true NODE_ENV=test vitest run .e2e.ts",
    "vitest:int": "IS_INTEGRATION_TEST=true IS_VITEST_TEST=true NODE_ENV=test vitest run",
    "vitest:int:coverage": "IS_INTEGRATION_TEST=true IS_VITEST_TEST=true NODE_ENV=test vitest run --coverage",
    "viz-bundle": "pnpm exec vite-bundle-visualizer"
  },
  "prettier": {
    "jsxSingleQuote": true,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.5",
    "@expo/metro-runtime": "~5.0.4",
    "better-sqlite3": "^12.2.0",
    "chess.js": "^1.4.0",
    "expo": "~53.0.20",
    "inferno": "^9.0.3",
    "inferno-create-element": "^9.0.3",
    "nativewind": "^4.1.23",
    "postgres": "^3.4.7",
    "preact": "^10.26.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.80.1",
    "react-native-css-interop": "^0.1.22",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "snabbdom": "^3.6.2",
    "swiper": "^11.2.10",
    "tsx": "^4.20.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@happy-dom/global-registrator": "^18.0.1",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.1.0",
    "@types/react": "~19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "cloc": "2.6.0-cloc",
    "concurrently": "^9.2.0",
    "dbmate": "^2.27.0",
    "degit": "^2.8.4",
    "dpdm": "^3.14.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "serve": "^14.2.4",
    "sort-package-json": "^3.4.0",
    "tailwindcss": "^3.4.17",
    "tailwindcssv4": "npm:tailwindcss@^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.0.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  }
}
