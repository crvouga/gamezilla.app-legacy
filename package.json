{
  "name": "next",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server:prod": "bun db:up && bun server",
    "server": "bun gamezilla/gamezilla.server.ts",
    "client:build": "vite build",
    "client:preview": "vite preview",
    "client": "vite",
    "ngrok": "ngrok start --all",
    "tc": "bun x tsc --noEmit --watch",
    "viz-bundle": "bun x vite-bundle-visualizer",
    "cir-deps": "bun x dpdm --progress --no-warning --no-tree ./gamezilla/gamezilla.client.tsx",
    "db:up": "dbmate -e DATABASE_URL up",
    "db:down": "dbmate -e DATABASE_URL down"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.4",
    "chess.js": "^1.0.0-beta.6",
    "preact": "^10.19.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.5.0",
    "@typescript-eslint/parser": "^5.57.1",
    "autoprefixer": "^10.4.14",
    "bun-types": "^1.0.11",
    "csv-parser": "^3.0.0",
    "eslint": "^8.38.0",
    "postcss": "^8.4.23",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.0.2",
    "vite": "^4.3.2",
    "vite-tsconfig-paths": "^4.2.0"
  },
  "engines": {
    "node": "18.x"
  }
