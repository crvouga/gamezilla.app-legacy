{
  "name": "gamezilla.app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server:prod": "bun x tsc && bun test && bun db:migrate:up && bun gamezilla-app/gamezilla-app.server.ts",
    "server": "bun --watch gamezilla-app/gamezilla-app.server.ts ",
    "db:migrate:up": "bun x dbmate -e DATABASE_URL up",
    "db:migrate:down": "bun x dbmate -e DATABASE_URL down",
    "db:up": "docker-compose -f docker-compose.local.yml up -d",
    "db:down": "docker-compose -f docker-compose.local.yml down",
    "db:new": "bun x dbmate new",
    "db:dump": "bun x dbmate dump",
    "test:int": "IS_INTEGRATION_TEST=true bun test",
    "test:unit": "IS_INTEGRATION_TEST=false bun test",
    "client:build": "vite build",
    "client:serve": "bun x serve -s dist -p 3001",
    "preview": "bun client:build && bun client:serve",
    "client": "vite --open",
    "ngrok": "ngrok start --all",
    "ngrok:config:edit": "ngrok config edit",
    "tc": "bun x tsc --noEmit --watch",
    "viz-bundle": "bun x vite-bundle-visualizer",
    "cir-deps": "bun x dpdm --progress --no-warning --no-tree ./gamezilla-app/gamezilla-app.client.tsx",
    "check-imports": "bun scripts/check-imports.ts",
    "cloc": "bun x cloc gamezilla-app",
    "pretty": "bun x prettier --write .",
    "gen-l18n": "bun gamezilla-app/@SHARED/l18n/l18n-gen.ts",
    "gen-routes": "bun gamezilla-app/@SHARED/routing/routes-gen.ts",
    "gen-guard": "bun gamezilla-app/@SHARED/guards/guards-gen.ts",
    "cg": "bun x concurrently \"bun gen-l18n\" \"bun gen-routes\"",
    "cg:watch": "bun --watch cg",
    "check": "bun cir-deps && bun x tsc"
  },
  "dependencies": {
    "chess.js": "^1.0.0-beta.6",
    "inferno": "^8.2.3",
    "pg": "^8.11.5",
    "preact": "^10.19.3",
    "react": "canary",
    "react-dom": "canary",
    "redis": "^4.6.13",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4",
    "twilio": "^5.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.7.0",
    "@types/pg": "^8.11.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.14",
    "babel-plugin-inferno": "^6.7.1",
    "babel-preset-es2015": "^6.24.1",
    "bun-types": "^1.0.11",
    "csv-parser": "^3.0.0",
    "postcss": "^8.4.23",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.3.2",
    "typescript": "^5.4.2",
    "vite": "5.2.8",
    "vite-plugin-inferno": "^0.0.1",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "engines": {
    "node": "18.x"
  }
}
